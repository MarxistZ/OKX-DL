# Copy to ~/.config/okx-lob-daily.env on the Tencent Cloud server.
# Server and systemd wrappers load this file before running scripts/lob_run_daily.sh.

# Instruments to update each day.
SYMBOLS="BTC-USDT-SWAP ETH-USDT-SWAP"

# Data and binary locations.
DATA_ROOT="$HOME/data/okx"
BIN="$HOME/Quant/OKX-DL/target/release/okx-lob"

# Google Drive remotes configured by rclone.
GDRIVE_PARQUET_DEST="gdrive:okx/parquet"
GDRIVE_TRANSFER_DEST="gdrive:okx/transfer"
GDRIVE_LOG_DEST="gdrive:okx/logs"

# Conservative Tencent Cloud Lighthouse defaults for 2 vCPU / 2GB RAM / 40GB SSD.
BUILD=0
LOOKBACK_DAYS=1
WORKERS=1
DL_CONCURRENCY=1
TRANSFER_JOBS=1
RCLONE_TRANSFERS=1
RCLONE_CHECKERS=2
ZSTD_LEVEL=3
RAW_MAX_GB=8
RAW_CHECK_INTERVAL_SECS=10
RETRY_DELAY_SECS=60
CLEAN_PARQUET_AFTER_UPLOAD=1
